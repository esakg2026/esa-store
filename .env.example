# Секреты магазина. Сам файл .env в интернет НЕ выкладывать (он в .gitignore).
# На Render эти же значения заданы в Environment → Environment Variables.

# SQL-база Postgres (Neon) — строка postgresql://...  Таблицы магазина: store_kv, store_orders_view
DATABASE_URL=
# Токен бота ESA Store от @BotFather
TG_BOT_TOKEN=
# Имя бота без @
TG_BOT_USERNAME=
# Ваш chat id в Telegram (бот покажет его по команде /myid)
TG_OWNER_CHAT_ID=
# Длинная случайная строка — защищает адрес бота от подделки
TG_WEBHOOK_SECRET=
# Ключ входа в приложение владельца /admin (длинная случайная строка, минимум 24 символа)
ADMIN_TOKEN=
# Ключи push-уведомлений приложения владельца (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Реквизиты — клиент увидит их ТОЛЬКО после подтверждения заказа
PAY_INFO=MBank / Optima по номеру +996 XXX XXX XXX
